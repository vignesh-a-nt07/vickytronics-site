pipeline {
  agent any

  environment {
    AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY_ID')
    AWS_SECRET_ACCESS_KEY = credentials('AWS_SECRET_ACCESS_KEY')

    AWS_REGION     = 'us-east-1'
    AWS_ACCOUNT_ID = '393078901209'

    FRONTEND_REPO = 'ecommerce-vicky-frontend'
    BACKEND_REPO  = 'ecommerce-vicky-backend'

    EKS_CLUSTER   = 'vickytronic-site-eks'
  }

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {

    stage('Checkout Code') {
      steps {
        checkout scm
      }
    }

    stage('Login to ECR') {
      steps {
        sh '''
          aws ecr get-login-password --region $AWS_REGION |
          docker login --username AWS --password-stdin \
          $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
        '''
      }
    }

    stage('Build & Push Backend Image') {
      steps {
        sh '''
          IMAGE_TAG=$(git rev-parse --short HEAD)
          BACKEND_URI=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$BACKEND_REPO

          docker build -t $BACKEND_URI:$IMAGE_TAG -t $BACKEND_URI:latest ./server
          docker push $BACKEND_URI:$IMAGE_TAG
          docker push $BACKEND_URI:latest
        '''
      }
    }

    stage('Build & Push Frontend Image') {
      steps {
        sh '''
          IMAGE_TAG=$(git rev-parse --short HEAD)
          FRONTEND_URI=$AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$FRONTEND_REPO

          docker build -f Dockerfile.dev \
            -t $FRONTEND_URI:$IMAGE_TAG \
            -t $FRONTEND_URI:latest .

          docker push $FRONTEND_URI:$IMAGE_TAG
          docker push $FRONTEND_URI:latest
        '''
      }
    }

    stage('Configure kubectl') {
      steps {
        sh '''
          aws eks update-kubeconfig \
            --region $AWS_REGION \
            --name $EKS_CLUSTER
        '''
      }
    }

    stage('Deploy with Helm') {
      steps {
        sh '''
          IMAGE_TAG=$(git rev-parse --short HEAD)

          helm upgrade --install ecommerce ./helm/lms \
            --namespace ecommerce \
            --create-namespace \
            --set backend.image.tag=$IMAGE_TAG \
            --set frontend.image.tag=$IMAGE_TAG
        '''
      }
    }
  }

  post {
    success {
      echo '✅ EKS deployment completed successfully'
    }
    failure {
      echo '❌ EKS deployment failed'
    }
  }
}
